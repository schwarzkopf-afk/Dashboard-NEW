                            <span class="p-2 rounded-xl bg-purple-500/10 text-purple-400 group-hover:scale-110 transition-transform"><i class="fa-solid fa-film text-sm"></i></span>
                            <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-md">Routine</span>
                        </div>
                        <div>
                            <p class="font-semibold text-sm text-slate-200">"Alexa, Filmabend"</p>
