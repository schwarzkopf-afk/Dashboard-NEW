    <!-- Footer -->
    <footer class="border-t border-slate-800/80 py-6 text-center text-xs text-slate-500">
        <p>SmartHome Zentrale für TP-Link Tapo, Kasa & Amazon Alexa &bull; Sichere lokale & Cloud Verbindung</p>
    </footer>

    <!-- Toast Notification Overlay -->
    <div id="toast" class="fixed bottom-6 right-6 bg-slate-900 border border-slate-700 text-slate-100 px-4 py-3 rounded-2xl shadow-2xl transform translate-y-20 opacity-0 transition-all duration-300 z-50 flex items-center space-x-3 text-sm">
        <i class="fa-solid fa-circle-info text-cyan-400"></i>
        <span id="toastMessage">Aktion erfolgreich ausgeführt</span>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        // Temperatures State
        let temperatures = { wz: 22.0, sz: 19.5, bz: 24.0 };

        // Adjust Thermostat Temperature
        function adjustTemp(room, amount) {
            temperatures[room] = Math.max(15.0, Math.min(30.0, temperatures[room] + amount));
            const elem = document.getElementById(`target-${room}`);
            if (elem) {
                elem.innerText = temperatures[room].toFixed(1) + '°';
            }
            showToast(`Kasa Thermostat ${room.toUpperCase()} auf ${temperatures[room].toFixed(1)}°C eingestellt`);
        }

        // Global Mode Selector
        function setMode(mode) {
            ['zuhause', 'abwesend', 'nacht', 'party'].forEach(m => {
                const btn = document.getElementById(`btn-mode-${m}`);
                if (btn) {
                    btn.className = "glass-card p-4 rounded-2xl flex items-center space-x-3.5 hover:border-slate-700 transition-all group";
                }
            });
            const activeBtn = document.getElementById(`btn-mode-${mode}`);
            if (activeBtn) {
                activeBtn.className = "glass-card p-4 rounded-2xl flex items-center space-x-3.5 transition-all group border-emerald-500/80 bg-emerald-500/10 shadow-lg shadow-emerald-500/5";
            }
            const names = { zuhause: 'Zuhause-Modus', abwesend: 'Abwesend-Modus (Kameras aktiv)', nacht: 'Nachtruhe aktiviert', party: 'Party-Modus' };
            showToast(names[mode]);
        }

        // Toggle Camera Privacy Mode
        function togglePrivacy(camId) {
            const btn = document.getElementById(`btn-privacy-${camId.replace('cam', '')}`);
            if (btn) {
                if (btn.innerText === 'Privatsphäre') {
                    btn.innerText = 'Aktiv';
                    btn.className = "px-3 py-1.5 rounded-xl bg-emerald-600 text-white text-xs font-medium transition shadow-md";
                    showToast('Kamera aus dem Privatsphäre-Modus geholt');
                } else {
                    btn.innerText = 'Privatsphäre';
                    btn.className = "px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-300 border border-slate-700 transition";
                    showToast('Kamera in den Privatsphäre-Modus versetzt');
                }
            }
        }

        // Alexa Connection Toggle
        let alexaConnected = true;
        function toggleAlexaConnection() {
            alexaConnected = !alexaConnected;
            const statusText = document.getElementById('alexa-status-text');
            const toggleBtn = document.getElementById('alexa-toggle-btn');
            if (alexaConnected) {
                statusText.className = "text-xs font-medium text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20";
                statusText.innerText = "Alexa Skill Gekoppelt";
                toggleBtn.innerText = "Trennen";
                showToast("Amazon Alexa Verbindung wiederhergestellt");
            } else {
                statusText.className = "text-xs font-medium text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/20";
                statusText.innerText = "Getrennt";
                toggleBtn.innerText = "Verbinden";
                showToast("Amazon Alexa Verbindung getrennt");
            }
        }

        // Trigger Alexa Routine
        function triggerRoutine(routineName) {
            showToast(`Alexa Routine ausgeführt: "${routineName}"`);
        }

        // Toast Notification System
        function showToast(message) {
            const toast = document.getElementById('toast');
            const messageEl = document.getElementById('toastMessage');
            messageEl.innerText = message;
            
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>