                    <button onclick="triggerRoutine('Ich bin weg')" class="p-4 bg-slate-900/60 hover:bg-slate-900 border border-slate-800 hover:border-cyan-500/40 rounded-2xl text-left transition space-y-2 group">
                        <div class="flex justify-between items-center">
                            <span class="p-2 rounded-xl bg-blue-500/10 text-blue-400 group-hover:scale-110 transition-transform"><i class="fa-solid fa-door-open text-sm"></i></span>
                            <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-md">Routine</span>
                        </div>
