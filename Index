                    </button>

                    <button onclick="triggerRoutine('Wohnzimmer heizen')" class="p-4 bg-slate-900/60 hover:bg-slate-900 border border-slate-800 hover:border-cyan-500/40 rounded-2xl text-left transition space-y-2 group">
                        <div class="flex justify-between items-center">
                            <span class="p-2 rounded-xl bg-amber-500/10 text-amber-400 group-hover:scale-110 transition-transform"><i class="fa-solid fa-fire text-sm"></i></span>
                            <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-md">Routine</span>
                        </div>
                        <div>
                            <p class="font-semibold text-sm text-slate-200">"Alexa, Heizung an"</p>
                            <p class="text-[11px] text-slate-400">Wohnzimmer Thermostat auf 23°C</p>
